// ─── Staff (admin panel): accounts with 2FA, roles → permissions, sessions, audit log ───

enum StaffStatus {
  ACTIVE
  DISABLED
}

model StaffUser {
  id                  String      @id @default(uuid(7)) @db.Uuid
  email               String      @unique @db.Citext
  name                String      @db.VarChar(120)
  /// argon2id hash.
  passwordHash        String      @map("password_hash") @db.VarChar(255)
  /// TOTP secret, encrypted at rest by the API (AES-256-GCM); never stored in plain text.
  totpSecretEncrypted String?     @map("totp_secret_encrypted") @db.VarChar(512)
  totpEnabledAt       DateTime?   @map("totp_enabled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step: a code can never be used twice (replay protection).
  totpLastStep        Int?        @map("totp_last_step")
  status              StaffStatus @default(ACTIVE)
  failedLoginCount    Int         @default(0) @map("failed_login_count")
  lockedUntil         DateTime?   @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?   @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt   DateTime?   @map("password_changed_at") @db.Timestamptz(3)
  /// Set when an admin created the account or reset the password: change it at next sign-in.
  mustChangePassword  Boolean     @default(false) @map("must_change_password")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles              StaffRole[]
  sessions           StaffSession[]
  auditLogs          AuditLog[]
  uploadedMedia      Media[]
  inventoryMovements InventoryMovement[]
  moderatedReviews   Review[]
  orderEvents        OrderEvent[]
  paymentReviews     PaymentProof[]
  settingsUpdated    Setting[]
  contactHandled     ContactMessage[]

  @@map("staff_users")
}

/// A named set of permissions ("Super admin", "Order manager", "Content editor"…).
/// Permissions are code-defined strings like "catalog.products.write".
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(60)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(300)
  /// Built-in roles cannot be deleted.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  staff       StaffRole[]

  @@map("roles")
}

model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String @db.VarChar(100)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

model StaffRole {
  staffId String @map("staff_id") @db.Uuid
  roleId  String @map("role_id") @db.Uuid

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role  Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([staffId, roleId])
  @@index([roleId])
  @@map("staff_roles")
}

model StaffSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  staffId    String    @map("staff_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expiresAt])
  @@map("staff_sessions")
}

/// Append-only record of every admin change: who, what, before/after, from where.
model AuditLog {
  id           String    @id @default(uuid(7)) @db.Uuid
  actorType    ActorType @map("actor_type")
  actorStaffId String?   @map("actor_staff_id") @db.Uuid
  /// e.g. "product.update", "order.status.change", "role.permissions.update".
  action       String    @db.VarChar(100)
  entityType   String    @map("entity_type") @db.VarChar(60)
  entityId     String?   @map("entity_id") @db.VarChar(64)
  /// { before, after } of the changed fields (secrets redacted).
  changes      Json?
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  requestId    String?   @map("request_id") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  actorStaff StaffUser? @relation(fields: [actorStaffId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorStaffId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
