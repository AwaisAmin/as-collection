# apps/api environment. Copy to `.env` (git-ignored). Real environment variables override this file.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# verbose | debug | log | warn | error | fatal
LOG_LEVEL=log

# Browser origins allowed to call the API with cookies (storefront, admin). Required in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Proxies trusted for the client IP: loopback | CIDR list | false. Never a hop count.
TRUST_PROXY=loopback

# Interactive docs at /api/docs (defaults to true outside production).
SWAGGER_ENABLED=true

# PostgreSQL (docker compose: `pnpm services:up` from the repo root).
DATABASE_URL=postgresql://as_dev:as_dev_password@127.0.0.1:5440/as_collection?schema=public
# Connections per API instance; per-query timeout; connect timeout.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Default rate limit per client IP.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Redis (docker compose). Cache is fail-open: if Redis is down the API still serves from Postgres.
REDIS_URL=redis://:as_dev_redis@127.0.0.1:6390/0
CATALOG_CACHE_TTL_SECONDS=300
# Where media keys are served from (CDN in production). Today the storefront serves /images/*.
MEDIA_PUBLIC_BASE_URL=http://localhost:3000
