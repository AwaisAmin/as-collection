# Local Docker services (compose.yaml). Copy to `.env` and change the passwords.
# These values are for LOCAL DEVELOPMENT ONLY — never reuse them in production.

POSTGRES_DB=as_collection
POSTGRES_USER=as_dev
POSTGRES_PASSWORD=as_dev_password
POSTGRES_PORT=5440

REDIS_PASSWORD=as_dev_redis
REDIS_PORT=6390

S3_ACCESS_KEY=as_dev_storage
S3_SECRET_KEY=as_dev_storage_secret
S3_PORT=9000
S3_CONSOLE_PORT=9001
