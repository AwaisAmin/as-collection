# ── Public (inlined into the browser bundle at build time) ──
# Public site URL (used for metadata / canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base URL of the NestJS API, if the browser ever needs to call it directly
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Google OAuth web client id (shows Google sign-in; the API's GOOGLE_CLIENT_IDS must include it)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Server-only (never sent to the browser) ──
# URL the Next.js server uses to reach the NestJS API (can be an internal network URL)
API_URL=http://localhost:4000/api/v1
API_TIMEOUT_MS=8000
# Shared with the API's STOREFRONT_REVALIDATE_SECRET (≥ 32 chars); enables POST /api/revalidate
REVALIDATE_SECRET=

# ── Media (uploaded images; the API's MEDIA_PUBLIC_BASE_URL) ──
# Production: CDN host(s) serving uploads, comma-separated, e.g. media.example.com
MEDIA_REMOTE_HOSTS=
# Development: public bucket the site proxies /media/* to (RustFS from compose.yaml)
MEDIA_BUCKET_URL=http://127.0.0.1:9000/as-media
