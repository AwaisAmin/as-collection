# apps/api environment. Copy to `.env` (git-ignored). Real environment variables override this file.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# verbose | debug | log | warn | error | fatal
LOG_LEVEL=log

# Browser origins allowed to call the API with cookies (storefront, admin). Required in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Proxies trusted for the client IP: loopback | CIDR list | false. Never a hop count.
TRUST_PROXY=loopback

# Interactive docs at /api/docs (defaults to true outside production).
SWAGGER_ENABLED=true

# PostgreSQL (docker compose: `pnpm services:up` from the repo root).
DATABASE_URL=postgresql://as_dev:as_dev_password@127.0.0.1:5440/as_collection?schema=public
# Connections per API instance; per-query timeout; connect timeout.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Default rate limit per client IP.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Redis (docker compose). Cache is fail-open: if Redis is down the API still serves from Postgres.
REDIS_URL=redis://:as_dev_redis@127.0.0.1:6390/0
CATALOG_CACHE_TTL_SECONDS=300
# Where media keys are served from (CDN in production). Seed images (/images/*) come from the
# storefront; uploads (/media/*) live in S3_PUBLIC_BUCKET (the web app proxies /media/* in dev).
MEDIA_PUBLIC_BASE_URL=http://localhost:3000

# Object storage: S3-compatible (docker compose RustFS locally; S3, R2 or Spaces in production).
# Leave the keys empty to use the SDK default chain (IAM role). Path-style is needed for RustFS/MinIO.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=as_dev_storage
S3_SECRET_ACCESS_KEY=as_dev_storage_secret
S3_FORCE_PATH_STYLE=true
# Private bucket (payment screenshots). Created automatically outside production.
S3_PRIVATE_BUCKET=as-private
# Public bucket for uploaded images (anonymous read, no listing; created with that policy outside
# production). Put the CDN in front of it and point MEDIA_PUBLIC_BASE_URL at the CDN.
S3_PUBLIC_BUCKET=as-media

# ─── Customer auth ───
# Secret (≥ 32 chars) keying OTP and IP hashes. REQUIRED in production: `openssl rand -base64 48`.
# AUTH_SECRET=
# Sessions slide to this many days on use (absolute cap 180).
SESSION_TTL_DAYS=30
# Sign-in routes: requests per minute per client IP.
AUTH_RATE_LIMIT_MAX=20
# OTP channels in fallback order: whatsapp,sms. `log` (development only) writes the code to the log.
OTP_CHANNELS=log
# Development only: include the code in the API response (local login UI). Never in production.
OTP_DEV_ECHO=true
# WhatsApp Cloud API — needs an approved AUTHENTICATION template.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_OTP_TEMPLATE=login_code
# WHATSAPP_TEMPLATE_LANGUAGE=en
# SMS fallback via Twilio. TWILIO_FROM: sender number (E.164) or Messaging Service SID (MG…).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Google OAuth client ids (comma-separated) whose ID tokens are accepted. Empty = Google sign-in off.
GOOGLE_CLIENT_IDS=

# ─── Staff (admin panel) ───
# AES-256-GCM key for staff 2FA secrets: base64 of 32 bytes (`openssl rand -base64 32`).
# Required in production; keep it out of database backups. Empty here = development key.
# STAFF_TOTP_KEY=
# Authenticator-app 2FA for every staff member (cannot be disabled in production).
STAFF_REQUIRE_2FA=true
# Sessions end after this much inactivity, and in any case this long after sign-in.
STAFF_SESSION_IDLE_MINUTES=120
STAFF_SESSION_MAX_HOURS=12

# ─── Background jobs ───
# Auto-cancel of unpaid transfers + cleanup of expired auth data (one instance runs each tick).
JOBS_ENABLED=true
# Bank / JazzCash / Easypaisa orders without a verified payment are cancelled after this many hours.
TRANSFER_PAYMENT_WINDOW_HOURS=48
# Optional: endpoint put into signed URLs when browsers reach storage on another host than the API
# (e.g. API → http://storage:9000 in Docker, browser → https://files.example.com).
# S3_PUBLIC_ENDPOINT=
