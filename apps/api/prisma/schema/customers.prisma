// ─── Customers: passwordless phone OTP + Google sign-in, sessions, address book ───

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

enum OtpChannel {
  WHATSAPP
  SMS
}

model Customer {
  id              String         @id @default(uuid(7)) @db.Uuid
  /// E.164 (+923001234567). Null only for Google-only accounts that never added a phone.
  phone           String?        @unique @db.VarChar(16)
  email           String?        @unique @db.Citext
  name            String?        @db.VarChar(120)
  /// Google account subject id ("sub" claim).
  googleSub       String?        @unique @map("google_sub") @db.VarChar(255)
  status          CustomerStatus @default(ACTIVE)
  marketingOptIn  Boolean        @default(false) @map("marketing_opt_in")
  phoneVerifiedAt DateTime?      @map("phone_verified_at") @db.Timestamptz(3)
  /// Set when the email came from a verified source (Google). Only verified emails link accounts.
  emailVerifiedAt DateTime?      @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?      @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions  CustomerSession[]
  addresses Address[]
  orders    Order[]
  reviews   Review[]

  @@index([createdAt(sort: Desc)])
  @@map("customers")
}

/// Opaque session token; only its SHA-256 hash is stored.
model CustomerSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

/// One login code sent to a phone. Only the code's hash is stored; attempts are capped.
model OtpChallenge {
  id         String     @id @default(uuid(7)) @db.Uuid
  phone      String     @db.VarChar(16)
  codeHash   String     @map("code_hash") @db.Char(64)
  channel    OtpChannel
  attempts   Int        @default(0) @db.SmallInt
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  /// SHA-256 of the requester IP (rate limiting without storing raw IPs).
  ipHash     String?    @map("ip_hash") @db.Char(64)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt(sort: Desc)])
  @@index([expiresAt])
  /// Cleanup job deletes old challenges by age.
  @@index([createdAt])
  @@map("otp_challenges")
}

model Address {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  label      String?  @db.VarChar(40)
  fullName   String   @map("full_name") @db.VarChar(120)
  phone      String   @db.VarChar(16)
  line1      String   @db.VarChar(200)
  line2      String?  @db.VarChar(200)
  city       String   @db.VarChar(80)
  province   String?  @db.VarChar(80)
  postalCode String?  @map("postal_code") @db.VarChar(12)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Plus a partial unique index (migration): at most one default address per customer.
  @@index([customerId])
  @@map("addresses")
}
