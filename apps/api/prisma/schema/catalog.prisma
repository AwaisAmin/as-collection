// ─── Catalog: categories, attributes, products, variants, inventory, media, collections ───

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// How an attribute's values are stored and filtered.
enum AttributeType {
  SELECT // one value from a list (Fabric: Lawn)
  MULTI_SELECT // several values (Colour: Black, Gold)
  TEXT
  NUMBER
  BOOLEAN
}

/// PRODUCT = describes the product (filters, specs). VARIANT = an option the shopper picks (Size, Shade).
enum AttributeScope {
  PRODUCT
  VARIANT
}

enum CollectionType {
  MANUAL // hand-picked products, ordered
  AUTOMATED // products matching `rules` (e.g. tag, attribute value, price, on sale)
}

enum MediaVisibility {
  PUBLIC // product images, banners (CDN)
  PRIVATE // payment screenshots (signed URLs only)
}

enum InventoryReason {
  RESTOCK
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
}

/// Any number of nested levels. `path` (ancestor ids incl. self, e.g. "/a/b/") and `depth` are
/// maintained by the API for breadcrumbs and subtree lookups; the tree itself is cached.
model Category {
  id             String   @id @default(uuid(7)) @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  slug           String   @unique @db.VarChar(120)
  name           String   @db.VarChar(120)
  description    String?
  path           String   @db.VarChar(2000)
  depth          Int      @default(0) @db.SmallInt
  position       Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  imageId        String?  @map("image_id") @db.Uuid
  bannerImageId  String?  @map("banner_image_id") @db.Uuid
  /// Category page hero copy: { eyebrow, description, focus } — validated in the API.
  banner         Json?
  seoTitle       String?  @map("seo_title") @db.VarChar(160)
  seoDescription String?  @map("seo_description") @db.VarChar(320)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent          Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]          @relation("CategoryTree")
  image           Media?              @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  bannerImage     Media?              @relation("CategoryBannerImage", fields: [bannerImageId], references: [id], onDelete: SetNull)
  primaryProducts Product[]           @relation("PrimaryCategory")
  productLinks    ProductCategory[]
  attributes      CategoryAttribute[]

  @@index([parentId, position])
  @@index([path])
  @@map("categories")
}

/// Admin-defined attribute (Fabric, Colour, Pieces, Size, Shade…). Filters are generated from these.
model Attribute {
  id           String         @id @default(uuid(7)) @db.Uuid
  code         String         @unique @db.VarChar(60)
  name         String         @db.VarChar(80)
  type         AttributeType
  scope        AttributeScope @default(PRODUCT)
  /// Shown as a filter on category / search pages.
  isFilterable Boolean        @default(true) @map("is_filterable")
  /// Shown in the product's specification table.
  isVisible    Boolean        @default(true) @map("is_visible")
  unit         String?        @db.VarChar(20)
  position     Int            @default(0)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  values        AttributeValue[]
  categories    CategoryAttribute[]
  productValues ProductAttributeValue[]
  variantValues VariantOptionValue[]

  @@index([position])
  @@map("attributes")
}

model AttributeValue {
  id          String   @id @default(uuid(7)) @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  /// URL-safe value used in filters: `?fabric=lawn`.
  value       String   @db.VarChar(80)
  label       String   @db.VarChar(120)
  /// Swatch colour for colour/shade values (#RRGGBB).
  swatch      String?  @db.VarChar(32)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  attribute     Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productValues ProductAttributeValue[]
  variantValues VariantOptionValue[]

  @@unique([attributeId, value])
  @@index([attributeId, position])
  @@map("attribute_values")
}

/// Which attributes apply to a category (inherited by its subcategories through `path`).
model CategoryAttribute {
  categoryId  String  @map("category_id") @db.Uuid
  attributeId String  @map("attribute_id") @db.Uuid
  isRequired  Boolean @default(false) @map("is_required")
  position    Int     @default(0)

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
  @@index([attributeId])
  @@map("category_attributes")
}

model Brand {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(120)
  description String?
  logoId      String?  @map("logo_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  logo     Media?    @relation("BrandLogo", fields: [logoId], references: [id], onDelete: SetNull)
  products Product[]

  @@map("brands")
}

model Product {
  id                String        @id @default(uuid(7)) @db.Uuid
  slug              String        @unique @db.VarChar(160)
  name              String        @db.VarChar(200)
  shortDescription  String?       @map("short_description") @db.VarChar(500)
  /// Long description (sanitised rich text / markdown).
  description       String?
  status            ProductStatus @default(DRAFT)
  primaryCategoryId String        @map("primary_category_id") @db.Uuid
  brandId           String?       @map("brand_id") @db.Uuid
  /// Display-only rows for the specs table: [{ label, value }] — free text, validated in the API.
  specifications    Json          @default("[]")
  /// Which size chart to offer (null = none).
  sizeGuide         String?       @map("size_guide") @db.VarChar(60)
  isFeatured        Boolean       @default(false) @map("is_featured")
  isBestseller      Boolean       @default(false) @map("is_bestseller")
  /// Denormalised from APPROVED reviews (average = sum / count) so listings never aggregate.
  ratingCount       Int           @default(0) @map("rating_count")
  ratingSum         Int           @default(0) @map("rating_sum")
  seoTitle          String?       @map("seo_title") @db.VarChar(160)
  seoDescription    String?       @map("seo_description") @db.VarChar(320)
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  primaryCategory Category                @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  brand           Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories      ProductCategory[]
  attributes      ProductAttributeValue[]
  variants        ProductVariant[]
  media           ProductMedia[]
  tags            ProductTag[]
  collections     CollectionProduct[]
  reviews         Review[]
  orderItems      OrderItem[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([primaryCategoryId, status])
  @@index([brandId])
  // Fuzzy / typo-tolerant name search (pg_trgm).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

/// Extra categories a product appears in (besides its primary one).
model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  position   Int    @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, position])
  @@map("product_categories")
}

/// A product-level attribute value. SELECT/MULTI_SELECT use `valueId`; others use the typed columns.
model ProductAttributeValue {
  id           String   @id @default(uuid(7)) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  attributeId  String   @map("attribute_id") @db.Uuid
  valueId      String?  @map("value_id") @db.Uuid
  textValue    String?  @map("text_value") @db.VarChar(500)
  numberValue  Decimal? @map("number_value") @db.Decimal(14, 4)
  booleanValue Boolean? @map("boolean_value")

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value     AttributeValue? @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId, valueId])
  // Facet filtering: "products with fabric = lawn".
  @@index([attributeId, valueId, productId])
  @@map("product_attribute_values")
}

/// A purchasable SKU. Single-variant products have exactly one variant with no options.
model ProductVariant {
  id                  String   @id @default(uuid(7)) @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  sku                 String   @unique @db.VarChar(64)
  /// Human label, e.g. "M" or "Ruby Red".
  title               String?  @db.VarChar(200)
  priceMinor          Int      @map("price_minor")
  compareAtPriceMinor Int?     @map("compare_at_price_minor")
  costMinor           Int?     @map("cost_minor")
  barcode             String?  @unique @db.VarChar(64)
  weightGrams         Int?     @map("weight_grams")
  isActive            Boolean  @default(true) @map("is_active")
  position            Int      @default(0)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  options      VariantOptionValue[]
  inventory    InventoryItem?
  movements    InventoryMovement[]
  reservations StockReservation[]
  media        ProductMedia[]
  orderItems   OrderItem[]

  @@index([productId, position])
  @@index([priceMinor])
  @@map("product_variants")
}

/// Which option values define a variant (Size = M). One value per attribute.
model VariantOptionValue {
  variantId   String @map("variant_id") @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid
  valueId     String @map("value_id") @db.Uuid

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute Attribute      @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  value     AttributeValue @relation(fields: [valueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeId])
  @@index([valueId])
  @@map("variant_option_values")
}

/// Stock per variant. `reserved` = held by checkouts in progress; available = onHand − reserved.
/// `version` enables optimistic locking for concurrent updates.
model InventoryItem {
  variantId         String   @id @map("variant_id") @db.Uuid
  onHand            Int      @default(0) @map("on_hand")
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(3) @map("low_stock_threshold")
  trackInventory    Boolean  @default(true) @map("track_inventory")
  allowBackorder    Boolean  @default(false) @map("allow_backorder")
  version           Int      @default(0)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory_items")
}

/// Append-only stock ledger: every change to `on_hand`, with who and why.
model InventoryMovement {
  id           String          @id @default(uuid(7)) @db.Uuid
  variantId    String          @map("variant_id") @db.Uuid
  delta        Int
  reason       InventoryReason
  /// e.g. an order number for SALE / RETURN.
  reference    String?         @db.VarChar(100)
  note         String?         @db.VarChar(500)
  actorStaffId String?         @map("actor_staff_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  actorStaff StaffUser?     @relation(fields: [actorStaffId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

/// Short-lived stock hold while a customer checks out; released when it expires.
model StockReservation {
  id          String   @id @default(uuid(7)) @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  quantity    Int
  /// Checkout idempotency key that owns the hold.
  checkoutKey String   @map("checkout_key") @db.VarChar(64)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([checkoutKey, variantId])
  @@index([expiresAt])
  @@index([variantId])
  @@map("stock_reservations")
}

/// A stored file (S3 key). Images are served through the CDN; PRIVATE files only via signed URLs.
model Media {
  id                String          @id @default(uuid(7)) @db.Uuid
  storageKey        String          @unique @map("storage_key") @db.VarChar(512)
  visibility        MediaVisibility @default(PUBLIC)
  mimeType          String          @map("mime_type") @db.VarChar(100)
  sizeBytes         Int             @map("size_bytes")
  width             Int?
  height            Int?
  alt               String?         @db.VarChar(300)
  checksumSha256    String?         @map("checksum_sha256") @db.Char(64)
  uploadedByStaffId String?         @map("uploaded_by_staff_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  uploadedBy       StaffUser?     @relation(fields: [uploadedByStaffId], references: [id], onDelete: SetNull)
  productMedia     ProductMedia[]
  categoryImages   Category[]     @relation("CategoryImage")
  categoryBanners  Category[]     @relation("CategoryBannerImage")
  brandLogos       Brand[]        @relation("BrandLogo")
  collectionImages Collection[]
  paymentProofs    PaymentProof[]

  @@index([createdAt(sort: Desc)])
  @@map("media")
}

/// Ordered product gallery. `variantId` pins an image to one variant (e.g. a shade).
model ProductMedia {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  position  Int     @default(0)
  /// Overrides the media alt text for this product.
  alt       String? @db.VarChar(300)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media           @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([productId, mediaId])
  @@index([productId, position])
  @@map("product_media")
}

model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique @db.VarChar(80)
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

/// Merchandising groups: occasions (Eid, Wedding…), seasonal edits, "Best of lawn"…
model Collection {
  id             String         @id @default(uuid(7)) @db.Uuid
  slug           String         @unique @db.VarChar(120)
  name           String         @db.VarChar(120)
  description    String?
  type           CollectionType @default(MANUAL)
  /// AUTOMATED rules, e.g. { all: [{ field: "tag", op: "in", value: ["eid"] }] } — validated in the API.
  rules          Json?
  imageId        String?        @map("image_id") @db.Uuid
  isActive       Boolean        @default(true) @map("is_active")
  position       Int            @default(0)
  startsAt       DateTime?      @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?      @map("ends_at") @db.Timestamptz(3)
  seoTitle       String?        @map("seo_title") @db.VarChar(160)
  seoDescription String?        @map("seo_description") @db.VarChar(320)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  image    Media?              @relation(fields: [imageId], references: [id], onDelete: SetNull)
  products CollectionProduct[]

  @@index([isActive, position])
  @@map("collections")
}

model CollectionProduct {
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
}
