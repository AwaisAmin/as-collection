// ─── Orders, payments, discounts ───

enum OrderStatus {
  PENDING // placed, awaiting confirmation call / payment check
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
}

enum PaymentStatus {
  UNPAID
  AWAITING_VERIFICATION // transfer screenshot uploaded
  PAID
  REFUNDED
  FAILED
}

enum PaymentProofStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum DiscountType {
  PERCENTAGE // value = percent × 100 (basis points), e.g. 1500 = 15 %
  FIXED_AMOUNT // value = minor units
  FREE_SHIPPING
}

/// Prices, names and the address are snapshotted: later catalog edits never change past orders.
model Order {
  id                 String        @id @default(uuid(7)) @db.Uuid
  /// Human order number, e.g. AS-261119-7K3QX.
  number             String        @unique @db.VarChar(20)
  /// Hash of the secret key in the confirmation link (guest access without login).
  accessKeyHash      String        @map("access_key_hash") @db.Char(64)
  customerId         String?       @map("customer_id") @db.Uuid
  status             OrderStatus   @default(PENDING)
  paymentMethod      PaymentMethod @map("payment_method")
  paymentStatus      PaymentStatus @default(UNPAID) @map("payment_status")
  customerName       String        @map("customer_name") @db.VarChar(120)
  phone              String        @db.VarChar(16)
  email              String?       @db.Citext
  shippingName       String        @map("shipping_name") @db.VarChar(120)
  shippingPhone      String        @map("shipping_phone") @db.VarChar(16)
  shippingLine1      String        @map("shipping_line1") @db.VarChar(200)
  shippingLine2      String?       @map("shipping_line2") @db.VarChar(200)
  shippingCity       String        @map("shipping_city") @db.VarChar(80)
  shippingProvince   String?       @map("shipping_province") @db.VarChar(80)
  shippingPostalCode String?       @map("shipping_postal_code") @db.VarChar(12)
  notes              String?       @db.VarChar(500)
  currency           String        @default("PKR") @db.Char(3)
  subtotalMinor      Int           @map("subtotal_minor")
  discountMinor      Int           @default(0) @map("discount_minor")
  shippingMinor      Int           @map("shipping_minor")
  totalMinor         Int           @map("total_minor")
  discountId         String?       @map("discount_id") @db.Uuid
  discountCode       String?       @map("discount_code") @db.VarChar(40)
  /// Client-generated key: retries of the same checkout never create a second order.
  idempotencyKey     String        @unique @map("idempotency_key") @db.VarChar(64)
  courier            String?       @db.VarChar(60)
  trackingNumber     String?       @map("tracking_number") @db.VarChar(64)
  placedAt           DateTime      @default(now()) @map("placed_at") @db.Timestamptz(3)
  confirmedAt        DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  shippedAt          DateTime?     @map("shipped_at") @db.Timestamptz(3)
  deliveredAt        DateTime?     @map("delivered_at") @db.Timestamptz(3)
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discount      Discount?      @relation(fields: [discountId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  events        OrderEvent[]
  paymentProofs PaymentProof[]

  @@index([customerId, placedAt(sort: Desc)])
  @@index([status, placedAt(sort: Desc)])
  @@index([phone])
  @@index([placedAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id                  String  @id @default(uuid(7)) @db.Uuid
  orderId             String  @map("order_id") @db.Uuid
  productId           String? @map("product_id") @db.Uuid
  variantId           String? @map("variant_id") @db.Uuid
  productName         String  @map("product_name") @db.VarChar(200)
  variantTitle        String? @map("variant_title") @db.VarChar(200)
  sku                 String  @db.VarChar(64)
  imageUrl            String? @map("image_url") @db.VarChar(1024)
  unitPriceMinor      Int     @map("unit_price_minor")
  compareAtPriceMinor Int?    @map("compare_at_price_minor")
  quantity            Int
  lineTotalMinor      Int     @map("line_total_minor")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  review  Review?

  @@index([orderId])
  @@index([variantId])
  @@index([productId])
  @@map("order_items")
}

/// Order timeline (status changes, payment checks, notes). Customer-visible rows feed tracking.
model OrderEvent {
  id                String       @id @default(uuid(7)) @db.Uuid
  orderId           String       @map("order_id") @db.Uuid
  type              String       @db.VarChar(40)
  status            OrderStatus?
  note              String?      @db.VarChar(1000)
  isCustomerVisible Boolean      @default(true) @map("is_customer_visible")
  actorType         ActorType    @map("actor_type")
  actorStaffId      String?      @map("actor_staff_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorStaff StaffUser? @relation(fields: [actorStaffId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Bank / JazzCash / Easypaisa transfer screenshot, stored as PRIVATE media.
model PaymentProof {
  id                String             @id @default(uuid(7)) @db.Uuid
  orderId           String             @map("order_id") @db.Uuid
  mediaId           String             @map("media_id") @db.Uuid
  method            PaymentMethod
  reference         String?            @db.VarChar(100)
  amountMinor       Int?               @map("amount_minor")
  status            PaymentProofStatus @default(PENDING)
  reviewedByStaffId String?            @map("reviewed_by_staff_id") @db.Uuid
  reviewedAt        DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  note              String?            @db.VarChar(500)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  media      Media      @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  reviewedBy StaffUser? @relation(fields: [reviewedByStaffId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("payment_proofs")
}

/// Coupon codes. Usage is counted atomically when an order is placed.
model Discount {
  id               String       @id @default(uuid(7)) @db.Uuid
  code             String       @unique @db.Citext
  description      String?      @db.VarChar(300)
  type             DiscountType
  value            Int
  minSubtotalMinor Int?         @map("min_subtotal_minor")
  maxDiscountMinor Int?         @map("max_discount_minor")
  startsAt         DateTime?    @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime?    @map("ends_at") @db.Timestamptz(3)
  usageLimit       Int?         @map("usage_limit")
  usageCount       Int          @default(0) @map("usage_count")
  perCustomerLimit Int?         @map("per_customer_limit")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@index([isActive, startsAt, endsAt])
  @@map("discounts")
}
